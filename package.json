{
  "name": "cesiumBase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "lint": "vue-cli-service lint",
    "copy:sfc": "node scripts/copy-sfc-assets.js",
    "copy:inline": "node scripts/copy-inline-plugin.js",
    "switch:sfc": "node scripts/switch-to-sfc.js sfc",
    "switch:iife": "node scripts/switch-to-sfc.js iife",
    "switch:status": "node scripts/switch-to-sfc.js status",
    "build:sfc:all": "cd ../sfcLib && npm run build:sfc && cd ../cesiumBase && npm run copy:sfc && npm run switch:sfc",
    "build:inline:all": "cd ../sfcLib && npm run build:inline && cd ../cesiumBase && npm run copy:inline",
    "build:test-sfc": "vite build --config vite.config.test-sfc.js",
    "build:test-sfc-all": "node scripts/build-sfc-components.js"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.0",
    "axios": "^1.16.1",
    "bootstrap": "^5.1.3",
    "bootstrap-icons": "^1.7.2",
    "bower": "^1.8.13",
    "cesium-navigation-es6": "^3.0.9",
    "cors": "^2.8.6",
    "echarts": "^5.2.2",
    "express": "^5.2.1",
    "jquery": "^3.6.0",
    "less": "^4.1.2",
    "npm": "^11.14.1",
    "three": "^0.183.2",
    "vue": "^3.5.34",
    "vue-beauty": "^2.0.0-beta.19"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.29.5",
    "@open-wc/webpack-import-meta-loader": "^0.4.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-service": "~5.0.8",
    "@vue/compat": "^3.5.34",
    "babel-eslint": "^10.1.0",
    "core-js": "^3.49.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.1",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.4",
    "vite": "^8.0.16",
    "vue-router": "^3.6.5",
    "vue-template-compiler": "^2.6.11"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false
    },
    "rules": {
      "no-debugger": "off",
      "no-console": "off"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
